#!/usr/bin/env python3
"""handoff: move a coding-agent session to another session, same device or another.

The agent writes the context (CONTEXT.md, PROMPT.md body, context/). This script
does everything deterministic: git, transport, checks, install.

Store = any directory inside any git repo you choose (e.g. <some-repo>/handoff).
Config = <store>/config.toml (single, shared across devices).
Pointer = ~/.config/handoff/store (text file with the store path, per device).
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
try:
    import tomllib  # 3.11+
except ModuleNotFoundError:  # pragma: no cover
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        tomllib = None
if os.environ.get("HANDOFF_TOML_FALLBACK"):  # tests: exercise the builtin parser
    tomllib = None
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
TEMPLATES = SKILL_DIR / "templates"
POINTER = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "handoff" / "store"
AUTO_START = "<!-- handoff:auto:start (generated by `handoff publish`, do not edit) -->"
AUTO_END = "<!-- handoff:auto:end -->"
FILL_MARK = "TODO(handoff)"
CONTEXT_BUDGET = 12_000  # bytes; CONTEXT.md must be condensed
DEFAULT_BRANCHES = {"main", "master", "develop", "trunk"}

DEFAULT_CONFIG = {
    "store": {"push": "auto"},  # auto: push only in remote mode | always | never
    "defaults": {
        "mode": "remote",  # remote (other device) | local (same device)
        "wip": "commit",  # remote mode: commit | refuse
        "local_wip": "keep",  # local mode: keep (leave in shared tree) | commit | refuse
        "wip_message": "wip(handoff): {slug}",
        "checkpoint": "auto",  # auto | none | push | pr
        "pr_draft": True,
        "pr_comment": False,
        "secret_scan": True,
        "target": "any",
        "cold_check": True,
    },
    "devices": {},
}

# Every settable key: (allowed values or type, help). Drives `config set` validation and `config show`.
SCHEMA = {
    "store.push": (["auto", "always", "never"], "push the store repo after writing: auto = only for remote handoffs"),
    "defaults.mode": (["remote", "local"], "remote = receiver on another device; local = same device"),
    "defaults.wip": (["commit", "refuse"], "remote mode, uncommitted work: WIP commit on the current branch, or stop"),
    "defaults.local_wip": (["keep", "commit", "refuse"], "local mode, uncommitted work: keep it in the shared tree, commit, or stop"),
    "defaults.wip_message": (str, "WIP commit message; {slug} and {id} are replaced"),
    "defaults.checkpoint": (["auto", "none", "push", "pr"],
                            "how the work reaches the receiver: auto = pr if the branch has an open PR, else push (none for local)"),
    "defaults.pr_draft": (bool, "checkpoint pr: open new PRs as drafts"),
    "defaults.pr_comment": (bool, "checkpoint pr: comment on the PR with the handoff id and sha"),
    "defaults.secret_scan": (bool, "scan handoff files and WIP changes for secrets (gitleaks if installed)"),
    "defaults.cold_check": (bool, "remote mode: confirm a fresh clone of the store sees the handoff"),
    "defaults.target": (["any", "claude", "codex", "cursor", "agy", "opencode", "gemini"], "default receiving agent"),
}


def parse_toml(text: str) -> dict:
    """tomllib when available; otherwise a small parser for the subset config.toml uses."""
    if tomllib:
        return tomllib.loads(text)
    out: dict = {}
    cur = out
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip() if not re.search(r"=\s*\"[^\"]*#", raw) else raw.strip()
        if not line:
            continue
        m = re.fullmatch(r"\[([^\]]+)\]", line)
        if m:
            cur = out
            for part in m.group(1).strip().split("."):
                cur = cur.setdefault(part.strip().strip('"'), {})
            continue
        k, _, v = line.partition("=")
        cur[k.strip()] = parse_value(v.strip())
    return out


def parse_value(v: str):
    v = re.sub(r"\s+#.*$", "", v) if not v.startswith('"') else v
    if v in ("true", "false"):
        return v == "true"
    if re.fullmatch(r"-?\d+", v):
        return int(v)
    if v.startswith("["):
        return [parse_value(x.strip()) for x in v.strip("[]").split(",") if x.strip()]
    m = re.match(r'"((?:[^"\\]|\\.)*)"', v)
    return m.group(1) if m else v


# Where each agent discovers user-level skills.
AGENT_SKILL_DIRS = {
    "claude": ["~/.claude/skills"],
    "codex": ["~/.agents/skills"],
    "opencode": ["~/.agents/skills"],
    "cursor": ["~/.cursor/skills"],
    "agy": ["~/.gemini/config/skills"],
    "gemini": ["~/.gemini/skills"],
}
AGENT_DETECT = {
    "claude": (["claude"], ["~/.claude"]),
    "codex": (["codex"], ["~/.codex"]),
    "opencode": (["opencode"], ["~/.config/opencode", "~/.opencode"]),
    "cursor": (["cursor", "cursor-agent"], ["~/.cursor"]),
    "agy": (["agy"], ["~/.gemini/antigravity", "~/.gemini/config"]),
    "gemini": (["gemini"], []),
}


# --------------------------------------------------------------------------- utils


class Fail(Exception):
    pass


def say(msg: str = "") -> None:
    print(msg, flush=True)


def warn(msg: str) -> None:
    print(f"warn: {msg}", file=sys.stderr, flush=True)


def run(args, cwd=None, check=True, env=None, input=None) -> str:
    p = subprocess.run(
        args, cwd=cwd, env=env, input=input, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if check and p.returncode != 0:
        raise Fail(f"`{' '.join(map(str, args))}` failed:\n{p.stderr.strip() or p.stdout.strip()}")
    return p.stdout.strip()


def ok(args, cwd=None) -> bool:
    return subprocess.run(args, cwd=cwd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def git(repo, *args, check=True) -> str:
    return run(["git", "-C", str(repo), *args], check=check)


def expand(p) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(str(p)))).resolve()


def now() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def host() -> str:
    return os.environ.get("HANDOFF_HOST") or socket.gethostname().split(".")[0]


def slugify(s: str) -> str:
    s = re.sub(r"[^a-zA-Z0-9]+", "-", s.strip().lower()).strip("-")
    return s[:40] or "handoff"


def deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in over.items():
        out[k] = deep_merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


# --------------------------------------------------------------------------- store


class Store:
    def __init__(self, path: Path):
        self.path = path
        if not self.path.is_dir():
            raise Fail(f"store dir {path} missing. Run `handoff init <dir>`.")
        try:
            self.repo = Path(git(path, "rev-parse", "--show-toplevel"))
        except Fail:
            raise Fail(f"store dir {path} is not inside a git repo")
        self.rel = self.path.relative_to(self.repo).as_posix() if self.path != self.repo else "."
        cfg_file = self.path / "config.toml"
        user = parse_toml(cfg_file.read_text()) if cfg_file.exists() else {}
        self.cfg = deep_merge(DEFAULT_CONFIG, user)
        dev = self.cfg.get("devices", {}).get(host(), {})
        self.cfg["defaults"] = deep_merge(self.cfg["defaults"], dev.get("defaults", {}))

    @classmethod
    def load(cls) -> "Store":
        env = os.environ.get("HANDOFF_STORE")
        if env:
            return cls(expand(env))
        if not POINTER.exists():
            raise Fail("handoff not configured on this device. Run `handoff init <dir-in-a-git-repo>`.")
        return cls(expand(POINTER.read_text().strip()))

    @property
    def d(self) -> dict:
        return self.cfg["defaults"]

    def branch(self) -> str:
        return git(self.repo, "rev-parse", "--abbrev-ref", "HEAD")

    def upstream(self) -> str | None:
        return git(self.repo, "rev-parse", "--abbrev-ref", "@{upstream}", check=False) or None

    def remote_url(self) -> str | None:
        up = self.upstream()
        name = up.split("/", 1)[0] if up else "origin"
        return git(self.repo, "remote", "get-url", name, check=False) or None

    def pull(self, quiet=False) -> None:
        if not self.upstream():
            return
        if not ok(["git", "-C", str(self.repo), "pull", "--ff-only", "--quiet"]):
            msg = f"store repo {self.repo} cannot fast-forward to {self.upstream()}; sync it manually"
            if quiet:
                warn(msg)
            else:
                raise Fail(msg)

    def should_push(self, mode: str) -> bool:
        p = self.cfg["store"]["push"]
        return p == "always" or (p == "auto" and mode == "remote")

    def commit(self, paths: list[Path], message: str) -> str | None:
        rels = [p.relative_to(self.repo).as_posix() for p in paths]
        git(self.repo, "add", "-A", "--", *rels)
        if not git(self.repo, "diff", "--cached", "--name-only", "--", *rels):
            return None
        # --only: commit exactly these paths, leave anything else the user staged alone.
        git(self.repo, "commit", "--quiet", "--only", "-m", message, "--", *rels)
        return git(self.repo, "rev-parse", "HEAD")

    def push(self, allow_extra: bool, ours: set[str]) -> None:
        up = self.upstream()
        if not up:
            remote = "origin" if git(self.repo, "remote", check=False) else None
            if not remote:
                raise Fail(f"store repo {self.repo} has no remote; cannot push (use mode local or add a remote)")
            git(self.repo, "push", "--quiet", "-u", remote, self.branch())
            return
        git(self.repo, "fetch", "--quiet", check=False)
        ahead = git(self.repo, "rev-list", f"{up}..HEAD").split()
        extra = [c for c in ahead if c not in ours]
        if extra and not allow_extra:
            listing = git(self.repo, "log", "--oneline", f"{up}..HEAD")
            raise Fail(
                f"store repo has unpushed commits that are not handoff commits:\n{listing}\n"
                "Push them yourself or re-run with --push-extra."
            )
        git(self.repo, "push", "--quiet")

    def projects(self) -> list[Path]:
        return sorted(p for p in self.path.iterdir() if p.is_dir() and (p / "LATEST").exists())


# --------------------------------------------------------------------------- project repo


def project_repo(cwd: Path) -> Path | None:
    out = run(["git", "-C", str(cwd), "rev-parse", "--show-toplevel"], check=False)
    return Path(out) if out else None


def origin_url(repo: Path) -> str | None:
    return git(repo, "remote", "get-url", "origin", check=False) or None


def project_slug(remote: str | None, repo: Path) -> str:
    if remote:
        m = re.search(r"[:/]([^/:]+)/([^/]+?)(\.git)?/?$", remote)
        if m:
            return slugify(f"{m.group(1)}-{m.group(2)}")
    return slugify(repo.name)


def same_remote(a: str | None, b: str | None) -> bool:
    norm = lambda u: re.sub(r"(\.git)?/?$", "", re.sub(r"^(https?://|ssh://|git@)", "", u or "").replace(":", "/")).lower()
    return bool(a and b) and norm(a) == norm(b)


# --------------------------------------------------------------------------- handoff dir


def load_manifest(hdir: Path) -> dict:
    return json.loads((hdir / "manifest.json").read_text())


def save_manifest(hdir: Path, m: dict) -> None:
    (hdir / "manifest.json").write_text(json.dumps(m, indent=2) + "\n")


def find_handoff(store: Store, ref: str | None, repo: Path | None) -> Path:
    """ref: id | project/id | 'latest' | None (latest for cwd project, else newest overall)."""
    ref = ref or "latest"
    if "/" in ref:
        p = store.path / ref
        if (p / "manifest.json").exists():
            return p
        raise Fail(f"handoff {ref} not found in {store.path}")
    candidates = []
    if repo:
        slug = project_slug(origin_url(repo), repo)
        if (store.path / slug).is_dir():
            candidates = [store.path / slug]
    if not candidates:
        candidates = store.projects()
    if ref != "latest":
        for proj in store.path.iterdir():
            if (proj / ref / "manifest.json").exists():
                return proj / ref
        raise Fail(f"handoff {ref} not found in {store.path}")
    best = None
    for proj in candidates:
        latest = (proj / "LATEST").read_text().strip() if (proj / "LATEST").exists() else ""
        if latest and (proj / latest / "manifest.json").exists():
            m = load_manifest(proj / latest)
            if m.get("status") in ("closed",):
                continue
            if not best or m["created"] > best[1]["created"]:
                best = (proj / latest, m)
    if not best:
        raise Fail("no open handoff found" + (f" for project {candidates[0].name}" if repo and candidates else ""))
    return best[0]


def render_auto(m: dict) -> str:
    r = m["repo"]
    s = m["store"]
    lines = [AUTO_START, "", f"**Handoff `{m['id']}`** · mode `{m['mode']}` · from `{m['source']['agent']}@{m['source']['host']}` · {m['created']}", ""]
    lines.append("## 0. Get in position")
    lines.append("")
    if m["mode"] == "local":
        lines.append(f"- Repo on this device: `{m['source']['repo_path']}`")
    lines += [
        f"- Repo: `{r['remote'] or '(no remote)'}`",
        f"- Branch: `{r['branch']}` at `{r['sha'][:12]}` · checkpoint `{r.get('checkpoint', 'push')}`" + (f" · PR: {r['pr']}" if r.get("pr") else ""),
        f"- Handoff files: store repo `{s['remote'] or s['repo_path']}` → `{s['path']}/`",
        "",
        "If the `handoff` skill is installed, `handoff pickup " + f"{m['project']}/{m['id']}" + "` does all of this. Otherwise:",
        "",
        "```sh",
    ]
    if r["remote"] and (m["mode"] == "remote" or r.get("checkpoint") in ("push", "pr")):
        lines += [
            f"git clone {r['remote']} <dir>   # skip if already cloned",
            "cd <dir>",
            f"git fetch origin {r['branch']}",
            f"git switch {r['branch']} && git merge --ff-only origin/{r['branch']}",
        ]
    else:
        lines += [f"cd {m['source'].get('repo_path', '<repo>')}", f"git switch {r['branch']}"]
    lines += [
        f"git rev-parse HEAD   # expect {r['sha']}",
        "```",
        "",
        f"Then read `CONTEXT.md` and anything under `context/` in `{s['path']}/`.",
    ]
    if m["repo"].get("wip") == "keep":
        lines += ["", "> Uncommitted changes were left in the working tree on purpose (same-device handoff). `git status` shows them."]
    lines += ["", AUTO_END]
    return "\n".join(lines)


def inject_auto(prompt: str, block: str) -> str:
    if AUTO_START in prompt and AUTO_END in prompt:
        pre, rest = prompt.split(AUTO_START, 1)
        _, post = rest.split(AUTO_END, 1)
        return pre + block + post
    return block + "\n\n" + prompt


# --------------------------------------------------------------------------- checks


ABS_PATH = re.compile(r"(?<![\w.])((?:/(?:home|Users|root|tmp|var|opt|mnt|media|private|srv|workspace)|~)/[^\s`'\")]+|[A-Z]:\\[^\s`'\"]+)")
SECRET_RX = re.compile(
    r"(AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|gho_[A-Za-z0-9]{36}|"
    r"sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|"
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----|(?i:(password|passwd|secret|api[_-]?key|token)\s*[:=]\s*['\"]?[^\s'\"]{8,}))"
)


class Checks:
    def __init__(self):
        self.items: list[dict] = []

    def add(self, name: str, status: str, detail: str = "") -> None:
        self.items.append({"check": name, "status": status, "detail": detail})

    @property
    def failed(self) -> bool:
        return any(i["status"] == "fail" for i in self.items)

    def report(self) -> str:
        icon = {"pass": "✓", "warn": "!", "fail": "✗", "skip": "-"}
        return "\n".join(f"  {icon[i['status']]} {i['check']}" + (f": {i['detail']}" if i["detail"] else "") for i in self.items)


def secret_scan(paths: list[Path]) -> list[str]:
    hits = []
    if shutil.which("gitleaks"):
        help_ = run(["gitleaks", "--help"], check=False)
        for p in paths:
            cmd = (["gitleaks", "dir", str(p)] if re.search(r"^\s+dir\s", help_, re.M)
                   else ["gitleaks", "detect", "--no-git", "-s", str(p)])
            r = subprocess.run(cmd + ["--no-banner", "--redact", "--exit-code", "3"], capture_output=True, text=True)
            if r.returncode == 3:
                hits.append(f"gitleaks found secrets in {p}")
        return hits
    for p in paths:
        files = [p] if p.is_file() else [f for f in p.rglob("*") if f.is_file()]
        for f in files:
            try:
                txt = f.read_text(errors="ignore")
            except OSError:
                continue
            if SECRET_RX.search(txt):
                hits.append(f"possible secret in {f.name}")
    return hits


def check_content(hdir: Path, m: dict, c: Checks) -> None:
    for f in ("PROMPT.md", "CONTEXT.md", "manifest.json"):
        c.add(f"{f} present", "pass" if (hdir / f).exists() else "fail")
    ctx = (hdir / "CONTEXT.md").read_text() if (hdir / "CONTEXT.md").exists() else ""
    prm = (hdir / "PROMPT.md").read_text() if (hdir / "PROMPT.md").exists() else ""
    left = [n for n, t in (("CONTEXT.md", ctx), ("PROMPT.md", prm)) if FILL_MARK in t]
    c.add("templates filled", "fail" if left else "pass", f"{FILL_MARK} left in {', '.join(left)}" if left else "")
    size = len(ctx.encode())
    c.add("CONTEXT.md condensed", "warn" if size > CONTEXT_BUDGET else "pass", f"{size} bytes (budget {CONTEXT_BUDGET})")
    if m["mode"] == "remote":
        texts = [("PROMPT.md", prm.split(AUTO_START)[0] + prm.split(AUTO_END)[-1]), ("CONTEXT.md", ctx)]
        texts += [(f"context/{f.name}", f.read_text(errors="ignore")) for f in (hdir / "context").rglob("*") if f.is_file() and not f.name.startswith(".") and f.suffix in (".md", ".txt", "")]
        bad = sorted({f"{n}: {x}" for n, t in texts for x in ABS_PATH.findall(t)})
        c.add("no device-local paths", "fail" if bad else "pass", "; ".join(bad[:5]))
    if m["_cfg"]["secret_scan"]:
        hits = secret_scan([hdir])
        c.add("no secrets in handoff", "fail" if hits else "pass", "; ".join(hits))


def check_work(repo: Path | None, m: dict, c: Checks) -> None:
    r = m["repo"]
    if not repo:
        c.add("work repo", "skip", "not run from inside the project")
        return
    if r.get("wip") != "keep":
        dirty = git(repo, "status", "--porcelain", "--untracked-files=normal")
        c.add("work tree clean", "fail" if dirty else "pass", f"{len(dirty.splitlines())} uncommitted paths" if dirty else "")
    head = git(repo, "rev-parse", "HEAD")
    c.add("HEAD matches manifest", "pass" if head == r["sha"] else "fail", "" if head == r["sha"] else f"HEAD {head[:12]} != {r['sha'][:12]}")
    if m["mode"] == "remote" or r.get("checkpoint") in ("push", "pr"):
        if not r["remote"]:
            c.add("branch on remote", "fail", "project has no origin remote")
            return
        out = run(["git", "ls-remote", r["remote"], f"refs/heads/{r['branch']}"], check=False)
        rsha = out.split()[0] if out else ""
        c.add("branch on remote at sha", "pass" if rsha == r["sha"] else "fail",
              "" if rsha == r["sha"] else f"remote {r['branch']} at {rsha[:12] or 'missing'}, expected {r['sha'][:12]}")
        ignored_needed = m.get("manual_files") or []
        if ignored_needed:
            c.add("manual files", "warn", "copy by hand: " + ", ".join(ignored_needed))
    if m["mode"] == "local":
        c.add("same-device pickup", "pass", "`handoff pickup --worktree <dir>` if both sessions keep running")


def check_store(store: Store, hdir: Path, m: dict, c: Checks) -> None:
    rel = hdir.relative_to(store.repo).as_posix()
    tracked = git(store.repo, "ls-files", "--", rel)
    dirty = git(store.repo, "status", "--porcelain", "--", rel)
    c.add("handoff committed in store", "pass" if tracked and not dirty else "fail", dirty[:200] if dirty else "")
    if m["mode"] != "remote" and not store.should_push(m["mode"]):
        return
    up = store.upstream()
    if not up:
        c.add("store pushed", "fail", "store repo branch has no upstream")
        return
    git(store.repo, "fetch", "--quiet", check=False)
    pushed = ok(["git", "-C", str(store.repo), "merge-base", "--is-ancestor", "HEAD", up])
    c.add("store pushed", "pass" if pushed else "fail", "" if pushed else f"HEAD not in {up}")
    if pushed and m["_cfg"]["cold_check"] and store.remote_url():
        with tempfile.TemporaryDirectory() as tmp:
            b = up.split("/", 1)[1]
            r = subprocess.run(
                ["git", "clone", "--quiet", "--depth", "1", "--branch", b, "--filter=blob:none", "--no-checkout", store.remote_url(), tmp],
                capture_output=True, text=True,
            )
            found = r.returncode == 0 and bool(run(["git", "-C", tmp, "ls-tree", "-r", "--name-only", "HEAD", "--", f"{rel}/PROMPT.md"], check=False))
            c.add("cold clone sees handoff", "pass" if found else "fail", "" if found else (r.stderr.strip()[:200] or "PROMPT.md missing in fresh clone"))


def run_checks(store: Store, hdir: Path, repo: Path | None, phase: str = "all") -> Checks:
    m = load_manifest(hdir)
    m["_cfg"] = store.d
    c = Checks()
    if repo and m["repo"]["remote"] and not same_remote(origin_url(repo), m["repo"]["remote"]):
        repo = None  # cwd is some other project
    if phase in ("all", "content"):
        check_content(hdir, m, c)
    if phase in ("all", "work"):
        check_work(repo, m, c)
    if phase in ("all", "store"):
        check_store(store, hdir, m, c)
    return c


# --------------------------------------------------------------------------- commands


def cmd_init(a) -> None:
    target = expand(a.dir)
    if a.clone:
        repo_dir = expand(a.clone_to) if a.clone_to else None
        if not repo_dir:
            raise Fail("--clone needs --clone-to <dir> (where to clone the repo)")
        if not repo_dir.exists():
            run(["git", "clone", "--quiet", a.clone, str(repo_dir)])
            say(f"cloned {a.clone} → {repo_dir}")
    target.mkdir(parents=True, exist_ok=True)
    if not project_repo(target):
        raise Fail(f"{target} is not inside a git repo. Pick a dir inside a git repo you sync between devices.")
    cfg = target / "config.toml"
    created = False
    if not cfg.exists():
        cfg.write_text((TEMPLATES / "config.toml").read_text())
        created = True
    POINTER.parent.mkdir(parents=True, exist_ok=True)
    POINTER.write_text(str(target) + "\n")
    store = Store(target)
    say(f"store: {store.path}  (repo {store.repo}, path {store.rel})")
    say(f"config: {cfg}" + ("  [created from template]" if created else "  [existing, shared]"))
    say("next: `handoff config show`, adjust with `handoff config set <key> <value>`, then `handoff config save [--push]`")


def cmd_new(a) -> None:
    store = Store.load()
    store.pull(quiet=True)
    repo = project_repo(Path.cwd())
    if not repo:
        raise Fail("run `handoff new` from inside the project repo you are handing off")
    mode = a.mode or store.d["mode"]
    remote = origin_url(repo)
    proj = project_slug(remote, repo)
    slug = slugify(a.slug or git(repo, "rev-parse", "--abbrev-ref", "HEAD"))
    hid = f"{dt.datetime.now().strftime('%Y%m%d-%H%M')}-{slug}"
    hdir = store.path / proj / hid
    if hdir.exists():
        raise Fail(f"{hdir} already exists")
    (hdir / "context").mkdir(parents=True)
    branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    m = {
        "id": hid,
        "project": proj,
        "slug": slug,
        "created": now(),
        "status": "draft",
        "mode": mode,
        "target": a.to or store.d["target"],
        "source": {"host": host(), "agent": a.agent or os.environ.get("HANDOFF_AGENT", "unknown"),
                   **({"repo_path": str(repo)} if mode == "local" else {})},
        "repo": {"remote": remote, "branch": branch, "base_sha": git(repo, "rev-parse", "HEAD"),
                 "sha": git(repo, "rev-parse", "HEAD"), "pr": None, "wip": None},
        "store": {"remote": store.remote_url(), "branch": store.branch(),
                  "path": f"{store.rel}/{proj}/{hid}".lstrip("./"), **({"repo_path": str(store.repo)} if mode == "local" else {})},
        "manual_files": [],
        "checks": [],
    }
    save_manifest(hdir, m)
    for name in ("PROMPT.md", "CONTEXT.md"):
        (hdir / name).write_text((TEMPLATES / name).read_text())
    say(f"created {hdir}")
    say(f"mode={mode} branch={branch} project={proj}")
    say("next: fill CONTEXT.md and PROMPT.md (replace every TODO(handoff)), add useful files to context/,")
    say(f"      then run `handoff publish {proj}/{hid}` from inside the project repo.")


def resolve_checkpoint(repo: Path, m: dict, cfg: dict, a) -> str:
    """User choice (flag) > config > auto. auto: local -> none; remote -> pr if the branch has an open PR, else push."""
    cp = a.checkpoint or cfg["checkpoint"]
    if cp == "auto":
        if m["mode"] == "local":
            cp = "none"
        else:
            cp = "pr" if open_pr(repo, m["repo"]["branch"]) else "push"
    if cp == "none" and m["mode"] == "remote":
        raise Fail("remote handoff needs the work on the remote: use checkpoint push or pr")
    return cp


def open_pr(repo: Path, branch: str) -> str | None:
    if not shutil.which("gh"):
        return None
    url = run(["gh", "pr", "view", branch, "--json", "url,state", "-q", 'select(.state=="OPEN") | .url'], cwd=repo, check=False)
    return url or None


def switch_branch(repo: Path, m: dict, name: str | None) -> None:
    """--branch NAME: put the work (committed + uncommitted) on NAME instead of the current branch."""
    cur = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    if not name or name == cur:
        return
    if ok(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", f"refs/heads/{name}"]):
        raise Fail(f"branch `{name}` already exists locally; switch to it yourself or pick another name")
    git(repo, "switch", "--quiet", "-c", name)  # carries uncommitted changes along
    m["repo"]["branch"] = name


def wip_commit(repo: Path, m: dict, cfg: dict, a, pushing: bool) -> None:
    dirty = git(repo, "status", "--porcelain")
    wip = a.wip or (cfg["local_wip"] if m["mode"] == "local" else cfg["wip"])
    if not dirty:
        m["repo"]["wip"] = "clean"
        return
    if wip == "keep":
        if m["mode"] == "remote":
            raise Fail("wip=keep is only valid for local handoffs; uncommitted changes would not reach the other device")
        m["repo"]["wip"] = "keep"
        return
    if wip == "refuse":
        raise Fail("work tree has uncommitted changes (wip=refuse). Commit them, or pass --wip commit.")
    branch = m["repo"]["branch"]
    if branch == "HEAD":
        raise Fail("detached HEAD; pass --branch <name> or switch to a branch first")
    if branch in DEFAULT_BRANCHES and pushing and not a.allow_default_branch:
        raise Fail(f"refusing to push a WIP commit to `{branch}`. Pass --branch <feature-branch>, or --allow-default-branch.")
    if cfg["secret_scan"]:
        changed = [repo / l[3:].split(" -> ")[-1].strip('"') for l in dirty.splitlines()]
        hits = secret_scan([p for p in changed if p.is_file()])
        if hits:
            raise Fail("secret scan blocked WIP commit:\n  " + "\n  ".join(hits))
    git(repo, "add", "-A")
    git(repo, "commit", "--quiet", *(["--no-verify"] if a.no_verify else []), "-m", cfg["wip_message"].format(slug=m["slug"], id=m["id"]))
    m["repo"]["wip"] = "commit"


def checkpoint(repo: Path, m: dict, cfg: dict, a) -> None:
    r = m["repo"]
    cp = r["checkpoint"]
    if cp == "none":
        return
    if not r["remote"]:
        raise Fail("project has no origin remote; cannot push a checkpoint (use --checkpoint none with a local handoff)")
    git(repo, "push", "--quiet", "-u", "origin", r["branch"])
    if cp == "pr":
        if not shutil.which("gh"):
            raise Fail("checkpoint pr needs the gh CLI (authenticated); use --checkpoint push instead")
        url = open_pr(repo, r["branch"])
        if not url:
            args = ["gh", "pr", "create", "--head", r["branch"], "--fill"]
            args += ["--draft"] if (cfg["pr_draft"] if a.draft is None else a.draft) else []
            args += ["--base", a.pr_base] if a.pr_base else []
            url = run(args, cwd=repo).splitlines()[-1]
        elif cfg["pr_comment"]:
            run(["gh", "pr", "comment", url, "--body", f"Handoff checkpoint `{m['id']}` at `{r['sha'][:12]}`."], cwd=repo, check=False)
        r["pr"] = url


def cmd_publish(a) -> None:
    store = Store.load()
    repo = project_repo(Path.cwd())
    hdir = find_handoff(store, a.ref, repo)
    m = load_manifest(hdir)
    if not repo or not (same_remote(origin_url(repo), m["repo"]["remote"]) or not m["repo"]["remote"]):
        raise Fail("run `handoff publish` from inside the project repo of this handoff")
    cfg = store.d
    if a.mode:
        m["mode"] = a.mode
    cur = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    if cur != m["repo"]["branch"]:
        warn(f"branch changed since `new`: {m['repo']['branch']} → {cur}")
        m["repo"]["branch"] = cur
    if m["mode"] == "local":
        m["source"]["repo_path"] = str(repo)
        m["store"]["repo_path"] = str(store.repo)
    m["manual_files"] = sorted(set(m.get("manual_files", []) + a.manual_file))
    save_manifest(hdir, m)

    # 1. content first: nothing is committed or pushed if the handoff itself is bad
    c = run_checks(store, hdir, repo, "content")
    if c.failed and not a.force:
        say("content checks failed:\n" + c.report())
        raise Fail("fix the failures above (or --force) and re-run publish")

    # 2. work branch: optional new branch, WIP commit, checkpoint (none | push | pr)
    switch_branch(repo, m, a.branch)
    m["repo"]["checkpoint"] = resolve_checkpoint(repo, m, cfg, a)
    wip_commit(repo, m, cfg, a, pushing=m["repo"]["checkpoint"] != "none")
    m["repo"]["sha"] = git(repo, "rev-parse", "HEAD")
    checkpoint(repo, m, cfg, a)
    save_manifest(hdir, m)
    (hdir / "PROMPT.md").write_text(inject_auto((hdir / "PROMPT.md").read_text(), render_auto(m)))
    w = run_checks(store, hdir, repo, "work")
    if w.failed and not a.force:
        say("work checks failed:\n" + w.report())
        raise Fail("fix the failures above (or --force) and re-run publish")

    # 3. store: commit (only the handoff paths) and push if the mode needs it
    m["status"] = "open"
    m["published"] = now()
    m["checks"] = c.items + w.items
    save_manifest(hdir, m)
    (hdir.parent / "LATEST").write_text(m["id"] + "\n")
    pushing = store.should_push(m["mode"])
    if pushing:
        store.pull()
    sha = store.commit([hdir, hdir.parent / "LATEST"], f"handoff({m['project']}): {m['id']}")
    if pushing:
        store.push(a.push_extra, {sha} if sha else set())
    pre = Checks()
    pre.items = c.items + w.items
    pushed = pushing
    post = run_checks(store, hdir, None, "store")
    cp = m["repo"]["checkpoint"]
    say(f"published {m['project']}/{m['id']}: mode {m['mode']}, checkpoint {cp}"
        + (f" ({m['repo']['pr']})" if m['repo'].get('pr') else "") + f", store {'pushed' if pushed else 'committed locally'}")
    say(pre.report())
    say(post.report())
    if post.failed:
        raise Fail("post-publish checks failed; the other session may not reach this handoff")
    say("")
    say("Paste this in the receiving session:")
    say("")
    say(f"  /handoff pickup {m['project']}/{m['id']}")
    say("")
    say(f"No skill there? Point the agent at `{m['store']['path']}/PROMPT.md` in {m['store']['remote'] or m['store'].get('repo_path')}.")


def cmd_verify(a) -> None:
    store = Store.load()
    repo = project_repo(Path.cwd())
    hdir = find_handoff(store, a.ref, repo)
    c = run_checks(store, hdir, repo, "all")
    say(f"{hdir.relative_to(store.path)}")
    say(c.report())
    if c.failed:
        raise Fail("checks failed")


def cmd_pickup(a) -> None:
    store = Store.load()
    store.pull(quiet=True)
    cwd_repo = project_repo(Path.cwd())
    hdir = find_handoff(store, a.ref, cwd_repo)
    m = load_manifest(hdir)
    r = m["repo"]
    repo = None
    if cwd_repo and (same_remote(origin_url(cwd_repo), r["remote"]) or (not r["remote"] and m["mode"] == "local")):
        repo = cwd_repo
    elif m["mode"] == "local" and m["source"].get("repo_path") and Path(m["source"]["repo_path"]).is_dir():
        repo = Path(m["source"]["repo_path"])
    elif a.clone_to and r["remote"]:
        dest = expand(a.clone_to)
        if not dest.exists():
            run(["git", "clone", "--quiet", r["remote"], str(dest)])
        repo = dest
    notes = []
    if not repo:
        notes.append(f"project repo not found here. Clone `{r['remote']}` (or re-run with --clone-to <dir>), cd into it, re-run pickup.")
    else:
        if r["remote"]:
            git(repo, "fetch", "--quiet", "origin", r["branch"], check=r.get("checkpoint") in ("push", "pr"))
        if a.worktree:
            wt = expand(a.worktree)
            new_branch = a.worktree_branch or f"{r['branch']}-{m['slug']}"
            git(repo, "worktree", "add", "-b", new_branch, str(wt), r["sha"])
            repo = wt
            if r.get("wip") == "keep":
                notes.append("uncommitted changes from the source session stay in the original tree, not in this worktree.")
            notes.append(f"parallel session: worktree {wt} on new branch `{new_branch}` from {r['sha'][:12]}; merge back into `{r['branch']}` when done.")
        else:
            cur = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
            dirty = git(repo, "status", "--porcelain")
            if cur != r["branch"]:
                if dirty and r.get("wip") != "keep":
                    raise Fail(f"{repo} has uncommitted changes on `{cur}`; stash/commit them before switching to `{r['branch']}`")
                wts = git(repo, "worktree", "list", "--porcelain")
                if f"branch refs/heads/{r['branch']}" in wts:
                    raise Fail(f"`{r['branch']}` is checked out in another worktree (another session?). "
                               "Use that dir, or `handoff pickup --worktree <dir>` for a parallel session.")
                if ok(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", f"refs/heads/{r['branch']}"]):
                    git(repo, "switch", "--quiet", r["branch"])
                else:
                    git(repo, "switch", "--quiet", "-c", r["branch"], "--track", f"origin/{r['branch']}")
            head = git(repo, "rev-parse", "HEAD")
            if head != r["sha"]:
                if ok(["git", "-C", str(repo), "merge-base", "--is-ancestor", "HEAD", r["sha"]]):
                    git(repo, "merge", "--quiet", "--ff-only", r["sha"])
                elif ok(["git", "-C", str(repo), "merge-base", "--is-ancestor", r["sha"], "HEAD"]):
                    notes.append(f"HEAD {head[:12]} is ahead of handoff sha {r['sha'][:12]} (new commits since handoff).")
                else:
                    raise Fail(f"local `{r['branch']}` ({head[:12]}) diverged from handoff sha {r['sha'][:12]}; reconcile manually")
    if m.get("manual_files"):
        notes.append("copy by hand (not in git): " + ", ".join(m["manual_files"]))
    m["status"] = "picked_up"
    m.setdefault("pickups", []).append({"host": host(), "agent": a.agent or os.environ.get("HANDOFF_AGENT", "unknown"), "at": now(),
                                        **({"repo_path": str(repo)} if repo else {})})
    save_manifest(hdir, m)
    try:
        sha = store.commit([hdir], f"handoff({m['project']}): pickup {m['id']}")
        if sha and store.should_push(m["mode"]):
            store.push(False, {sha})
    except Fail as e:
        warn(f"could not record pickup in store: {e}")
    say(f"# handoff {m['project']}/{m['id']}")
    say(f"handoff dir: {hdir}")
    if repo:
        say(f"work repo:   {repo}  (branch {git(repo, 'rev-parse', '--abbrev-ref', 'HEAD')} @ {git(repo, 'rev-parse', '--short', 'HEAD')})")
    for n in notes:
        say(f"note: {n}")
    say("")
    say("=" * 30 + " MAIN PROMPT " + "=" * 30)
    say((hdir / "PROMPT.md").read_text())


def cmd_list(a) -> None:
    store = Store.load()
    if not a.no_pull:
        store.pull(quiet=True)
    rows = []
    for proj in store.projects():
        for h in proj.iterdir():
            if (h / "manifest.json").exists():
                m = load_manifest(h)
                if a.all or m["status"] != "closed":
                    rows.append((m["created"], f"{proj.name}/{m['id']}", m["status"], m["mode"], m["repo"]["branch"]))
    for r in sorted(rows, reverse=True):
        say(f"{r[0]}  {r[1]:<60} {r[2]:<10} {r[3]:<7} {r[4]}")
    if not rows:
        say("no handoffs")


def cmd_close(a) -> None:
    store = Store.load()
    hdir = find_handoff(store, a.ref, project_repo(Path.cwd()))
    m = load_manifest(hdir)
    m["status"] = "closed"
    m["closed"] = now()
    save_manifest(hdir, m)
    sha = store.commit([hdir], f"handoff({m['project']}): close {m['id']}")
    if sha and store.should_push(m["mode"]):
        store.push(False, {sha})
    say(f"closed {m['project']}/{m['id']}")


def format_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    return json.dumps(str(v))


def coerce(key: str, raw: str):
    base = re.sub(r"^devices\.[^.]+\.", "", key)
    if base not in SCHEMA:
        raise Fail(f"unknown key `{key}`. Keys: {', '.join(SCHEMA)} (or devices.<hostname>.defaults.<key>)")
    kind = SCHEMA[base][0]
    if kind is bool:
        if raw.lower() not in ("true", "false", "yes", "no", "on", "off"):
            raise Fail(f"`{key}` takes true or false")
        return raw.lower() in ("true", "yes", "on")
    if isinstance(kind, list) and raw not in kind:
        raise Fail(f"`{key}` takes one of: {', '.join(kind)}")
    return raw


def set_toml_key(text: str, section: str, key: str, value: str) -> str:
    """Set key in [section], keeping comments and layout. Appends the section if missing."""
    lines = text.splitlines()
    start = next((i for i, l in enumerate(lines) if l.strip() == f"[{section}]"), None)
    if start is None:
        return text.rstrip("\n") + f"\n\n[{section}]\n{key} = {value}\n"
    end = next((i for i in range(start + 1, len(lines)) if re.match(r"\s*\[", lines[i])), len(lines))
    for i in range(start + 1, end):
        m = re.match(rf"^(\s*{re.escape(key)}\s*=\s*)(\"(?:[^\"\\\\]|\\\\.)*\"|[^#]*?)(\s*#.*)?$", lines[i])
        if m:
            lines[i] = f"{m.group(1)}{value}{m.group(3) or ''}"
            return "\n".join(lines) + "\n"
    ins = end
    while ins > start + 1 and not lines[ins - 1].strip():
        ins -= 1
    lines.insert(ins, f"{key} = {value}")
    return "\n".join(lines) + "\n"


def cmd_config(a) -> None:
    store = Store.load()
    cfg_file = store.path / "config.toml"
    if a.action == "path":
        say(str(cfg_file))
        return
    if a.action == "show":
        say(f"# {cfg_file}  (host: {host()}; per-device overrides from [devices.{host()}.defaults] applied)")
        for key, (kind, help_) in SCHEMA.items():
            sec, k = key.split(".")
            val = store.cfg[sec][k] if sec == "store" else store.d[k]
            allowed = " | ".join(kind) if isinstance(kind, list) else ("true | false" if kind is bool else "text")
            say(f"{key:<24} = {format_value(val):<16} # {allowed}: {help_}")
        return
    if a.action == "set":
        key = a.key if a.key.startswith(("store.", "defaults.", "devices.")) else f"defaults.{a.key}"
        if a.device:
            if not key.startswith("defaults."):
                raise Fail("--device only applies to defaults.* keys")
            key = f"devices.{host()}.{key}"
        val = coerce(key, a.value)
        section, k = key.rsplit(".", 1)
        text = cfg_file.read_text() if cfg_file.exists() else (TEMPLATES / "config.toml").read_text()
        cfg_file.write_text(set_toml_key(text, section, k, format_value(val)))
        parse_toml(cfg_file.read_text())  # must still parse
        say(f"{key} = {format_value(val)}  (in {cfg_file}; `handoff config save` to commit)")
        return
    if a.action == "save":
        sha = store.commit([cfg_file], "chore(handoff): update handoff config")
        say("committed config.toml" if sha else "config.toml unchanged")
        if a.push:
            store.push(a.push_extra, {sha} if sha else set())
            say("pushed store repo")


def detect_agents() -> list[str]:
    found = []
    for name, (bins, dirs) in AGENT_DETECT.items():
        if any(shutil.which(b) for b in bins) or any(expand(d).exists() for d in dirs):
            found.append(name)
    return found


def skill_targets(agents: list[str]) -> list[Path]:
    targets = []
    for ag in agents:
        dirs = list(AGENT_SKILL_DIRS[ag])
        env = {"claude": "CLAUDE_CONFIG_DIR", "codex": "CODEX_HOME"}.get(ag)
        if env and os.environ.get(env):
            dirs.append(f"{os.environ[env]}/skills")
        for d in dirs:
            t = expand(d) / "handoff"
            if t not in targets:
                targets.append(t)
    return targets


def link(src: Path, dst: Path, force: bool) -> str:
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.is_symlink():
        if dst.resolve() == src.resolve():
            return "ok"
        dst.unlink()
    elif dst.exists():
        if not force:
            return f"skipped (exists, not ours; --force to back up and replace)"
        bak = dst.with_name(dst.name + f".bak-{dt.datetime.now():%Y%m%d%H%M%S}")
        dst.rename(bak)
    dst.symlink_to(src)
    return "linked"


def cmd_install(a) -> None:
    detected = detect_agents()
    agents = detected if a.agents in (None, "all") else [x.strip() for x in a.agents.split(",") if x.strip()]
    unknown = [x for x in agents if x not in AGENT_SKILL_DIRS]
    if unknown:
        raise Fail(f"unknown agents {unknown}; known: {', '.join(AGENT_SKILL_DIRS)}")
    say(f"agents: {', '.join(agents)}" + ("  (detected)" if a.agents in (None, "all") else ""))
    for t in skill_targets(agents) + [expand(d) / "handoff" for d in a.skill_dir]:
        say(f"  skill {t}: {link(SKILL_DIR, t, a.force)}")
    bindir = expand(a.bin_dir)
    say(f"  cli   {bindir / 'handoff'}: {link(SKILL_DIR / 'bin' / 'handoff', bindir / 'handoff', a.force)}")
    if str(bindir) not in os.environ.get("PATH", "").split(os.pathsep):
        warn(f"{bindir} is not on PATH")
    try:
        store = Store.load()
        say(f"store: {store.path}")
    except Fail as e:
        say(f"store: not configured ({e})")


def cmd_uninstall(a) -> None:
    removed = 0
    for t in skill_targets(list(AGENT_SKILL_DIRS)) + [expand(d) / "handoff" for d in a.skill_dir] + [expand(a.bin_dir) / "handoff"]:
        if t.is_symlink() and t.resolve().is_relative_to(SKILL_DIR):
            t.unlink()
            removed += 1
            say(f"removed {t}")
    if a.purge and POINTER.exists():
        POINTER.unlink()
        if not any(POINTER.parent.iterdir()):
            POINTER.parent.rmdir()
        say(f"removed {POINTER} (store and its handoffs are untouched)")
    if not removed:
        say("no handoff links found")


def cmd_doctor(a) -> None:
    c = Checks()
    c.add("python >= 3.9", "pass" if sys.version_info >= (3, 9) else "fail", sys.version.split()[0] + ("" if tomllib else " (builtin TOML subset parser)"))
    c.add("git", "pass" if shutil.which("git") else "fail")
    c.add("handoff on PATH", "pass" if shutil.which("handoff") else "warn", shutil.which("handoff") or "run `handoff install`")
    try:
        store = Store.load()
        c.add("store", "pass", f"{store.path} (repo {store.repo})")
        c.add("config.toml", "pass" if (store.path / "config.toml").exists() else "warn", "defaults in use" if not (store.path / "config.toml").exists() else "")
        url = store.remote_url()
        if url:
            reach = ok(["git", "ls-remote", "--exit-code", "-q", url, "HEAD"]) or ok(["git", "ls-remote", "-q", url])
            c.add("store remote reachable", "pass" if reach else "fail", url)
        else:
            c.add("store remote", "warn", "none: only local handoffs possible")
    except Fail as e:
        c.add("store", "fail", str(e))
    for ag in detect_agents():
        ts = skill_targets([ag])
        good = [t for t in ts if t.exists() and (t / "SKILL.md").exists()]
        c.add(f"skill installed for {ag}", "pass" if good else "warn", ", ".join(map(str, good or ts)))
    if shutil.which("gh"):
        c.add("gh auth (for checkpoint=pr)", "pass" if ok(["gh", "auth", "status"]) else "warn")
    say(c.report())
    if c.failed:
        raise Fail("doctor found problems")


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="handoff", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)

    p = sp.add_parser("init", help="point this device at a store dir inside a git repo")
    p.add_argument("dir", help="store dir inside a git repo, e.g. <repo>/handoff")
    p.add_argument("--clone", help="git URL of the repo that holds the store (clone it first)")
    p.add_argument("--clone-to", help="where to clone --clone")
    p.set_defaults(fn=cmd_init)

    p = sp.add_parser("new", help="create a draft handoff for the current project")
    p.add_argument("--slug")
    p.add_argument("--mode", choices=["local", "remote"])
    p.add_argument("--to", help="target agent (claude, codex, cursor, agy, any)")
    p.add_argument("--agent", help="source agent name")
    p.set_defaults(fn=cmd_new)

    p = sp.add_parser("publish", help="commit/push work + handoff, run checks, print paste line")
    p.add_argument("ref", nargs="?")
    p.add_argument("--mode", choices=["local", "remote"])
    p.add_argument("--wip", choices=["commit", "refuse", "keep"])
    p.add_argument("--manual-file", action="append", default=[], help="file the receiver must copy by hand (e.g. .env); repeatable")
    p.add_argument("--checkpoint", choices=["auto", "none", "push", "pr"], help="how the work reaches the receiver (default: config)")
    p.add_argument("--branch", help="move the work to this new branch before committing/pushing")
    p.add_argument("--pr-base", help="checkpoint pr: base branch for a new PR")
    p.add_argument("--draft", dest="draft", action="store_true", default=None, help="checkpoint pr: new PR as draft")
    p.add_argument("--ready", dest="draft", action="store_false", help="checkpoint pr: new PR ready for review")
    p.add_argument("--allow-default-branch", action="store_true")
    p.add_argument("--no-verify", action="store_true", help="skip git hooks on the WIP commit")
    p.add_argument("--push-extra", action="store_true", help="also push unrelated unpushed commits in the store repo")
    p.add_argument("--force", action="store_true", help="publish despite failed pre-checks")
    p.set_defaults(fn=cmd_publish)

    p = sp.add_parser("verify", help="run all checks on a handoff")
    p.add_argument("ref", nargs="?")
    p.set_defaults(fn=cmd_verify)

    p = sp.add_parser("pickup", help="pull the handoff, position the repo, print the main prompt")
    p.add_argument("ref", nargs="?", help="project/id, id, or latest (default)")
    p.add_argument("--clone-to", help="clone the project here if it is not present")
    p.add_argument("--worktree", help="same device, parallel session: new worktree at this path")
    p.add_argument("--worktree-branch", help="branch name for --worktree")
    p.add_argument("--agent")
    p.set_defaults(fn=cmd_pickup)

    p = sp.add_parser("list", help="list open handoffs")
    p.add_argument("--all", action="store_true")
    p.add_argument("--no-pull", action="store_true")
    p.set_defaults(fn=cmd_list)

    p = sp.add_parser("close", help="mark a handoff closed")
    p.add_argument("ref", nargs="?")
    p.set_defaults(fn=cmd_close)

    p = sp.add_parser("install", help="install the skill for coding agents")
    p.add_argument("--agents", help="all (default: detected) or comma list: " + ",".join(AGENT_SKILL_DIRS))
    p.add_argument("--skill-dir", action="append", default=[], help="extra skills dir to link into (repeatable), e.g. a second Claude config dir")
    p.add_argument("--bin-dir", default="~/.local/bin")
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_install)

    p = sp.add_parser("uninstall", help="remove skill symlinks created by install")
    p.add_argument("--skill-dir", action="append", default=[])
    p.add_argument("--bin-dir", default="~/.local/bin")
    p.add_argument("--purge", action="store_true", help="also forget this device's store pointer")
    p.set_defaults(fn=cmd_uninstall)

    p = sp.add_parser("config", help="show / set / save the shared config")
    csp = p.add_subparsers(dest="action", required=True)
    csp.add_parser("show", help="effective config for this device, with allowed values").set_defaults(fn=cmd_config)
    csp.add_parser("path", help="print the config file path").set_defaults(fn=cmd_config)
    q = csp.add_parser("set", help="set a key, e.g. `checkpoint pr` or `--device mode local`")
    q.add_argument("key")
    q.add_argument("value")
    q.add_argument("--device", action="store_true", help="write under [devices.<this host>.defaults]")
    q.set_defaults(fn=cmd_config)
    q = csp.add_parser("save", help="commit config.toml (only that file)")
    q.add_argument("--push", action="store_true", help="also push the store repo")
    q.add_argument("--push-extra", action="store_true")
    q.set_defaults(fn=cmd_config)

    p = sp.add_parser("doctor", help="check this device's setup")
    p.set_defaults(fn=cmd_doctor)

    a = ap.parse_args(argv)
    try:
        a.fn(a)
    except Fail as e:
        print(f"handoff: {e}", file=sys.stderr)
        return 1
    except BrokenPipeError:  # output piped into `head`, `grep -q`, ...
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    return 0


if __name__ == "__main__":
    sys.exit(main())
